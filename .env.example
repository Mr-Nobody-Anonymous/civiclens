# ======================================================================
# CivicLens Ethiopia — environment configuration (prefix CL_)
# Copy to .env and adjust. NEVER commit real secrets.
# ======================================================================

# --- core ---
CL_ENV=development                       # development | production
CL_SECRET_KEY=change-me-to-a-long-random-string

# --- database ---
# Dev default: SQLite. Production: PostgreSQL, e.g.
# CL_DATABASE_URL=postgresql+psycopg://civiclens:password@db:5432/civiclens
CL_DATABASE_URL=sqlite:///./civiclens.db

# --- file/video storage ---
CL_STORAGE_BACKEND=local                 # local | s3
CL_STORAGE_DIR=./storage
# S3 backend (only if CL_STORAGE_BACKEND=s3):
# CL_S3_BUCKET=civiclens-media
# CL_S3_ENDPOINT=https://s3.example.com
# CL_S3_ACCESS_KEY=...
# CL_S3_SECRET_KEY=...

# --- upload limits ---
CL_MAX_VIDEO_MB=100
CL_MAX_IMAGE_MB=10

# --- local AI service ---
CL_AI_SERVICE_URL=http://127.0.0.1:8090
CL_AI_FRAMES_PER_VIDEO=3

# AI service's own config (ai-service process env):
# AI_MODEL=heuristic                     # heuristic | ollama
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llava:7b                  # vision model; llama3.1 for text-only

# --- background jobs ---
CL_JOB_BACKEND=thread                    # thread (in-process) | redis (worker)
CL_REDIS_URL=redis://localhost:6379/0

# --- notifications ---
CL_EMAIL_BACKEND=console                 # console | smtp
CL_EMAIL_FROM=no-reply@civiclens.et
# CL_SMTP_HOST=smtp.example.com
# CL_SMTP_PORT=587
# CL_SMTP_USER=...
# CL_SMTP_PASSWORD=...

# --- anti-abuse ---
CL_RATE_LIMIT_REPORTS_PER_HOUR=10
CL_RATE_LIMIT_AUTH_PER_MINUTE=10
CL_DUPLICATE_RADIUS_M=150
CL_DUPLICATE_WINDOW_DAYS=7

# --- cities (first = default) ---
CL_CITIES=Addis Ababa,Adama,Bahir Dar,Hawassa,Mekelle,Dire Dawa,Gondar,Jimma
CL_DEFAULT_CITY_LAT=9.0108
CL_DEFAULT_CITY_LNG=38.7613

# ======================================================================
# Added by production hardening
# ======================================================================
# --- upload hardening ---
CL_MAX_VIDEO_SECONDS=300
CL_MAX_ATTACHMENTS=6

# --- AI confidence thresholds (gate auto-assignment / manual review) ---
CL_AI_CONF_HIGH=0.75
CL_AI_CONF_LOW=0.5

# --- background job retries ---
CL_JOB_MAX_ATTEMPTS=3
CL_JOB_BACKOFF_BASE_S=5

# --- login lockout ---
CL_LOGIN_MAX_FAILURES=8
CL_LOGIN_LOCK_MINUTES=15

# --- privacy: public coordinate fuzzing ---
CL_PUBLIC_COORD_DECIMALS=4         # ~11 m
CL_SENSITIVE_COORD_DECIMALS=3      # ~110 m for sensitive categories
CL_SENSITIVE_CATEGORIES=Education,Safety
CL_RETENTION_DAYS=0                # 0 = keep forever

# --- SMTP extras ---
CL_SMTP_TLS=true
CL_EMAIL_FROM_NAME=CivicLens Ethiopia

# ======================================================================
# PRODUCTION PROFILE (uncomment + fill; see PRODUCTION.md)
# ======================================================================
# CL_ENV=production
# CL_SECRET_KEY=<openssl rand -hex 48>
# CL_DATABASE_URL=postgresql+psycopg://civiclens:<password>@db:5432/civiclens
# CL_JOB_BACKEND=redis
# CL_REDIS_URL=redis://redis:6379/0
# CL_STORAGE_BACKEND=s3
# CL_EMAIL_BACKEND=smtp

# --- final validation additions ---
CL_RATE_LIMIT_BACKEND=            # "" follow CL_JOB_BACKEND | memory | redis (shared across instances)
CL_DUPLICATE_ANALYZERS=geo_text   # pluggable: geo_text[,image_embedding,video_embedding later]
# Production safety: MUST be false in production (seed.py refuses otherwise)
CL_SEED_DEMO_DATA=true
CL_CREATE_DEMO_ACCOUNTS=true

# ======================================================================
# DEPLOYMENT TOPOLOGY (see DEPLOYMENT.md)
# ======================================================================
# Same-origin (default, recommended): SPA served by the API or proxied in
# front of it (vercel.json/netlify.toml rewrites) — leave these empty.
#
# Split deployment (SPA on Vercel/Netlify origin, API elsewhere, no proxy):
# CL_CORS_ORIGINS=https://civiclens.vercel.app        # exact origins, comma separated
# CL_COOKIE_SAMESITE=                                 # ""=auto (none when CORS set), lax, none, strict
# CL_PUBLIC_BASE_URL=https://civiclens.vercel.app     # used for links in e-mails

# --- docker compose one-shot admin bootstrap (remove after first boot) ---
# CL_ADMIN_EMAIL=admin@yourcity.gov.et
# CL_ADMIN_PASSWORD=<strong password, min 8 chars>
# CL_ADMIN_NAME=Administrator

# --- prebuilt images (docker-compose.prebuilt.yml) ---
# CIVICLENS_IMAGE=ghcr.io/OWNER/REPO
# CIVICLENS_TAG=latest
# CIVICLENS_PORT=8000

# --- web push notifications (optional; generate once per deployment) ---
# python -m app.push --generate-keys     (run inside backend/)
# CL_VAPID_PUBLIC_KEY=
# CL_VAPID_PRIVATE_KEY=
# CL_VAPID_SUBJECT=mailto:admin@example.com

# --- worker scaling ---
# Parallel jobs per worker process (raise on bigger machines; add worker
# replicas for horizontal scaling — see civiclens_queue_depth metric)
# CL_WORKER_CONCURRENCY=2

# --- monitoring overlay (docker-compose.monitoring.yml) ---
# GRAFANA_PASSWORD=<strong password>
