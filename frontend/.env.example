# Frontend build-time configuration (Vite; values are baked into the bundle).
#
# VITE_API_BASE — ONLY for split deployments where the API lives on a
# DIFFERENT origin than the SPA and you are NOT using a platform rewrite/proxy
# (vercel.json / netlify.toml already proxy /api/* so the browser stays
# same-origin — leave this empty in that case, it is the recommended setup).
#
# If you set it, the API must allow the SPA's origin:
#   CL_CORS_ORIGINS=https://your-frontend.vercel.app   (on the API side)
#
# VITE_API_BASE=https://api.civiclens.example.com
VITE_API_BASE=
