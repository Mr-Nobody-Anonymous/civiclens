{
  "uid": "civiclens-overview",
  "title": "CivicLens — Platform Overview",
  "tags": ["civiclens"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "HTTP requests / s by status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum by (status) (rate(civiclens_http_requests_total[5m]))", "legendFormat": "{{status}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 2, "type": "timeseries", "title": "Latency p50 / p95 / p99",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(civiclens_http_request_seconds_bucket[5m])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(civiclens_http_request_seconds_bucket[5m])))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(civiclens_http_request_seconds_bucket[5m])))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 3, "type": "timeseries", "title": "5xx error rate",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [{ "expr": "sum(rate(civiclens_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(civiclens_http_requests_total[5m]))", "legendFormat": "5xx ratio" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1 }, "overrides": [] }
    },
    {
      "id": 4, "type": "stat", "title": "Open reports",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "targets": [{ "expr": "civiclens_open_reports" }]
    },
    {
      "id": 5, "type": "stat", "title": "Worker heartbeat age",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "targets": [{ "expr": "civiclens_worker_heartbeat_age_seconds" }],
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [
        { "color": "green", "value": null }, { "color": "yellow", "value": 60 }, { "color": "red", "value": 120 } ] } }, "overrides": [] }
    },
    {
      "id": 6, "type": "timeseries", "title": "Job queue depth (scale workers when sustained > 25)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "civiclens_queue_depth", "legendFormat": "queued (redis)" },
        { "expr": "civiclens_jobs_gauge{status=\"running\"}", "legendFormat": "running" },
        { "expr": "civiclens_jobs_gauge{status=\"dead\"}", "legendFormat": "dead" }
      ]
    },
    {
      "id": 7, "type": "timeseries", "title": "Jobs completed / failed per minute",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "sum by (status) (rate(civiclens_jobs_total[5m])) * 60", "legendFormat": "{{status}}" }
      ]
    },
    {
      "id": 8, "type": "timeseries", "title": "AI service calls",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [{ "expr": "sum by (outcome) (rate(civiclens_ai_requests_total[5m])) * 60", "legendFormat": "{{outcome}}/min" }]
    },
    {
      "id": 9, "type": "timeseries", "title": "AI analysis duration p95",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(civiclens_ai_seconds_bucket[10m])))", "legendFormat": "p95" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    }
  ]
}
