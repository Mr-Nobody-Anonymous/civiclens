# CivicLens Ethiopia — production reverse proxy (Nginx)
# Replace cert paths with your real certificates (e.g. from certbot/Let's Encrypt).
# Never commit certificates or keys to the repository.

# HTTP -> HTTPS redirect
server {
    listen 80;
    server_name civiclens.example.et;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name civiclens.example.et;

    ssl_certificate     /etc/letsencrypt/live/civiclens.example.et/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/civiclens.example.et/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # HSTS — only enable once you are certain this domain will ALWAYS use HTTPS.
    # (The API also sends this header when CL_ENV=production; setting it here as
    # well guarantees it on every response, including proxy-generated errors.)
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Large video uploads (keep in sync with CL_MAX_VIDEO_MB) + generous timeouts
    client_max_body_size 120m;
    proxy_read_timeout   300s;
    proxy_send_timeout   300s;

    # Everything (API + built SPA) is served by the FastAPI container.
    # SPA fallback is handled by the app itself, so a single proxy block suffices.
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # video streaming: pass Range requests through untouched
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;
        proxy_buffering off;          # stream video bytes as they arrive
    }

    # health endpoints may be probed frequently; skip logs
    location /api/health { proxy_pass http://127.0.0.1:8000; access_log off; }
    location /api/ready  { proxy_pass http://127.0.0.1:8000; access_log off; }
}
